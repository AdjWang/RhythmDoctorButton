/*
/ {
    /* Button for key press */
    buttons {
        compatible = "gpio-keys";
        key0: button_0 {
            gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Single Key";
            zephyr,code = <INPUT_KEY_ENTER>;
        };
    };

    /* PWM LED (single LED for example) */
    pwmleds {
        compatible = "pwm-leds";
        led0: pwm_led0 {
            pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
            label = "User LED";
        };
    };

    /* GPIO Output for LED control (alternative to PWM) */
    leds {
        compatible = "gpio-leds";
        led1: led_1 {
            gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;  /* Red LED on DK */
            label = "Status LED";
        };
    };

    aliases {
        sw0 = &key0;
        pwm-led0 = &led0;
    };
};

/* Configure PWM0 */
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
};

/* Configure ADC for battery reading */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;  /* P0.04, adjust for your board */
        zephyr,resolution = <12>;
    };
};

/* Disable unused peripherals to save power. */
&uart0 { status = "disabled"; };
&uart1 { status = "disabled"; };
&i2c0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&spi0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&qspi { status = "disabled"; };
&usbd { status = "disabled"; };
&nfct { status = "disabled"; };
&ieee802154 { status = "disabled"; };
*/

/ {
	aliases {
		led0 = &led0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio9 0 GPIO_ACTIVE_HIGH>;
			label = "Green LED 0";
		};
	};

    chosen {
        zephyr,flash-controller = &flash_controller;
        zephyr,flash = &flash0;
    };
};

/* Enable USB CDC ACM console. */
&usbd { status = "okay"; };

&gpiote130 {
	status = "okay";
};

&gpio9 {
	status = "okay";
};
